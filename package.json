{
  "name": "object-map",
  "version": "0.1.0-beta.3",
  "private": true,
  "description": "A shared product model your coding agent maintains while it builds: an OOUX object map installed into a repository, populated from the implementation and read on a local canvas.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MetaHeavies/object-map.git"
  },
  "bugs": {
    "url": "https://github.com/MetaHeavies/object-map/issues"
  },
  "homepage": "https://github.com/MetaHeavies/object-map#readme",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare.mjs && vite --host 127.0.0.1",
    "demo": "node scripts/demo.mjs",
    "build": "vite build",
    "package:skill": "npm run build && node scripts/package-skill.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:portable": "node tests/portable.mjs",
    "generate": "node tests/fixtures/generator/generate.mjs",
    "install:map": "node scripts/install.mjs",
    "atlas": "node examples/atlas/server.mjs"
  },
  "dependencies": {
    "animejs": "^4.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.6",
    "vite": "^7.0.0"
  }
}
